{
  "name": "l1-support-ai-widget",
  "private": true,
  "version": "1.0.0",
  "description": "L1 Support AI Widget: AI-powered technical support copilot for Omnidesk and BookStack using Google Gemini",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "NODE_OPTIONS=\"--max-old-space-size=512\" vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test test/security.test.ts test/skills_import.test.ts test/escalation_note.test.ts test/classification.test.ts test/first_response_ticket_number.test.ts test/image_recognition.test.ts test/safety_workflows.test.ts test/gpt_knowledge_integration.test.ts test/stop_words.test.ts",
    "sync-skills": "python3 prompts_and_skills/sync.py --check",
    "export-skills": "python3 prompts_and_skills/sync.py --export"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
